/* CoronLP adaptation of the CoreX keymap (81135d5).
 * PMW3610, XIAO BLE wiring, inertia and LED hardware stay CoronLP-specific.
 * No rotary encoders. Extra inner switches 32/33 remain unassigned.
 */

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <mouse-gesture.dtsi>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>
#include <behaviors/default_layer.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&zip_temp_layer { excluded-positions = <21 22 23 35 36>; };

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&zip_mouse_gesture {
    mac-layer = <1>;
    stroke-size = <100>;
    movement-threshold = <6>;
    gesture-cooldown-ms = <250>;
    enable-eager-mode;

    desktop_left {
        pattern = <GESTURE_LEFT>;
        win-bindings = <&kp LC(LG(LEFT_ARROW))>;
        mac-bindings = <&kp LC(LEFT_ARROW)>;
    };

    desktop_right {
        pattern = <GESTURE_RIGHT>;
        win-bindings = <&kp LC(LG(RIGHT_ARROW))>;
        mac-bindings = <&kp LC(RIGHT_ARROW)>;
    };

    desktop_overview_up {
        pattern = <GESTURE_UP>;
        win-bindings = <&kp LG(TAB)>;
        mac-bindings = <&kp LC(UP_ARROW)>;
    };

    desktop_overview_down {
        pattern = <GESTURE_DOWN>;
        win-bindings = <&kp LG(TAB)>;
        mac-bindings = <&kp LC(DOWN_ARROW)>;
    };
};

&trackball_listener {
    status = "okay";
    input-processors =
        <&zip_temp_layer 7 0>;

    pan_win_scroll {
        layers = <4>;
        input-processors = <
            &zip_xy_transform INPUT_TRANSFORM_Y_INVERT
            &zip_axis_lock
            &zip_xy_to_scroll_mapper
#if defined(CORON_SCROLL_INERTIA)
            &scroll_inertia_win
#endif
            &zip_scroll_scaler 1 12
        >;
    };

    pan_mac_scroll {
        layers = <5>;
        input-processors = <
            &zip_xy_transform INPUT_TRANSFORM_Y_INVERT
            &zip_axis_lock
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
#if defined(CORON_SCROLL_INERTIA)
            &scroll_inertia_mac
#endif
            &zip_scroll_scaler 1 12
        >;
    };

    desktop_layer_gesture {
        layers = <6>;
        input-processors = <
            &zip_mouse_gesture
            &zip_xy_scaler 0 1
        >;
    };
    typing_layers {
        layers = <2 3>;
        input-processors = <&zip_xy_scaler 1 1>;
    };
};

/ {
    #if defined(CORON_SCROLL_INERTIA)

    /* Inertia emits directly to HID: apply direction transforms before it,
     * and keep scale/scale-div equal to the downstream scroll scaler.
     * Only the right (central) half can emit mouse HID reports.
     */

    scroll_inertia_win: scroll_inertia_win {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        axis = <0>;
        layer = <4>;
        scale = <1>;
        scale-div = <12>;

        /* Initial thresholds for the 400 CPI, 125 Hz sensor. */

        start = <16>;
        move = <32>;
        stop = <1>;
        tick = <8>;
        release = <24>;
        span = <2000>;
    };

    scroll_inertia_mac: scroll_inertia_mac {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        axis = <0>;
        layer = <5>;
        scale = <1>;
        scale-div = <12>;
        start = <16>;
        move = <32>;
        stop = <1>;
        tick = <8>;
        release = <24>;
        span = <2000>;
    };

    #endif

    layer_listeners {
        compatible = "zmk,layer-listeners";

        desktop_gesture_auto_toggle {
            layers = <6>;
            bindings = <&mouse_gesture_on &mouse_gesture_off>;
        };
    };

    macros {
        pair_paren: pair_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Pair ()";
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LS(N9) &kp LS(N0) &kp LEFT>;
        };

        pair_square: pair_square {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Pair []";
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LBKT &kp RBKT &kp LEFT>;
        };

        pair_brace: pair_brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Pair {}";
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp LS(LBKT) &kp LS(RBKT) &kp LEFT>;
        };

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        bt0_mac: bt0_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &df DF_BLE_SEL 1>;
            label = "BT0_MAC";
        };

        bt1_win: bt1_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &df DF_BLE_SEL 0>;
            label = "BT1_WIN";
        };

        bt2_win: bt2_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &df DF_BLE_SEL 0>;
            label = "BT2_WIN";
        };

        bt3_win: bt3_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &df DF_BLE_SEL 0>;
            label = "BT3_WIN";
        };

        bt4_win: bt4_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &df DF_BLE_SEL 0>;
            label = "BT4_WIN";
        };
    };

    behaviors {
        /* Consumes rotation without output; an omitted binding would fall
         * through to the WIN/MAC base layer.
         */

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        WIN {
            display-name = "WIN";
            bindings = <
&kp ESC &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &mt SEMICOLON SQT &kp BACKSPACE
&kp TAB &kp A &kp S &kp D &kp F &kp G &lt 8 LG(LS(S)) &kp LC(N0) &kp H &kp J &kp K &kp L &kp P &kp ENTER
&kp LEFT_SHIFT &kp Z &kp X &kp C &kp V &kp B &none &none &kp N &kp M &kp COMMA &kp DOT &mt EQUAL MINUS &kp RSHFT
&kp LCTRL &kp LEFT_WIN &kp LEFT_ALT &kp SPACE &lt 4 LANG1 &mo 6 &none &lt 2 LANG2 &mo 3 &kp SLASH &kp DELETE
            >;
        };

        MAC {
            display-name = "MAC";
            bindings = <
&kp ESC &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &mt SEMICOLON SQT &kp BACKSPACE
&kp TAB &kp A &kp S &kp D &kp F &kp G &lt 8 LG(LS(N4)) &kp LG(N0) &kp H &kp J &kp K &kp L &kp P &kp ENTER
&kp LEFT_SHIFT &kp Z &kp X &kp C &kp V &kp B &none &none &kp N &kp M &kp COMMA &kp DOT &mt EQUAL MINUS &kp RSHFT
&kp LEFT_GUI &kp LCTRL &kp LEFT_ALT &kp SPACE &lt 5 LANG1 &mo 6 &none &lt 2 LANG2 &mo 3 &kp SLASH &kp DELETE
            >;
        };

        NUM {
            display-name = "NUM";
            bindings = <
&trans &trans &trans &trans &trans &trans &kp BACKSLASH &pair_paren &pair_square &kp N1 &kp N2 &kp N3
&trans &trans &trans &trans &trans &trans &trans &trans &pair_brace &kp UNDERSCORE &kp TILDE &kp N4 &kp N5 &kp N6
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp GRAVE &kp N7 &kp N8 &kp N9
&trans &trans &trans &trans &trans &trans &kp N0 &trans &trans &trans &trans
            >;
        };

        FN {
            display-name = "FN";
            bindings = <
&trans &trans &trans &trans &trans &trans &kp BACKSLASH &pair_paren &pair_square &kp F1 &kp F2 &kp F3
&trans &trans &trans &trans &trans &trans &trans &trans &pair_brace &kp UNDERSCORE &kp TILDE &kp F4 &kp F5 &kp F6
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp GRAVE &kp F7 &kp F8 &kp F9
&trans &trans &trans &trans &trans &trans &kp F10 &trans &trans &kp F11 &kp F12
            >;
        };

        PAN_WIN {
            display-name = "PAN_WIN";
            bindings = <
&trans &trans &kp UP &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &kp LEFT &kp DOWN &kp RIGHT &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        PAN_MAC {
            display-name = "PAN_MAC";
            bindings = <
&trans &trans &kp UP &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &kp LEFT &kp DOWN &kp RIGHT &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        GESTURE {
            display-name = "GESTURE";
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &mkp MB1 &mkp MB3 &mkp MB2 &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &mkp MB4 &mkp MB5 &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;

        };

        BLUETOOTH {
            display-name = "BLUETOOTH";
            bindings = <
&bootloader &trans &trans &trans &trans &trans &bt0_mac &bt1_win &bt2_win &bt3_win &bt4_win &bootloader
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &bt BT_CLR
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
